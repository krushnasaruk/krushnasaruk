# Auto detect text files and ensure LF line endings
* text=auto eol=lf

# Force LF for files that must have it (GitHub Actions runners are Linux)
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
